includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    paths:
        - app
        - database
        - routes
    level: 8
    ignoreErrors:
        # SQL dinámico con fragmentos generados por el propio código (columnas de listas blancas, fechas, subconsultas) nunca con texto del usuario.
        # Los valores del usuario siempre van como parámetros (?). Cada archivo está revisado; no ampliar sin revisión.
        -
            message: '#expects (Illuminate\\Contracts\\Database\\Query\\Expression\|)?literal-string,#'
            identifier: argument.type
            paths:
                - app/Http/Controllers/Api/V1/QuotationController.php
                - app/Services/ConversationList.php
                - app/Services/CustomerSalesReport.php
                - app/Services/SalesStatistics.php
                - app/Services/Reports/SalesFigures.php
                - app/Services/Reports/Branches/BranchCategoryMix.php
        # `$request->user()` nunca es nulo en controladores y peticiones: las rutas que lo usan están detrás de `auth:sanctum` y del
        # middleware de permisos (las públicas —inicio de sesión, webhooks— no lo usan). Solo se admite en estas dos carpetas.
        -
            message: '#(on |expects App\\Models\\User, )App\\Models\\User\|null( given)?\.?#'
            paths:
                - app/Http/Controllers
                - app/Http/Requests
